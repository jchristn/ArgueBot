{
  "name": "arguebot-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test:ci": "vitest run",
    "test:e2e": "npm run build && dotnet build ../src/Test.Fixtures -c Release --no-restore && dotnet build ../src/ArgueBot.Server -c Release --no-restore && playwright test",
    "i18n:check": "node scripts/check-i18n.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "i18next": "25.6.0",
    "react-i18next": "16.2.0",
    "i18next-icu": "2.4.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "vite": "6.4.3",
    "@vitejs/plugin-react": "4.7.0",
    "vitest": "5.0.5",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "26.1.0",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0"
  }
}
