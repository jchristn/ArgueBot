# Copy to docker/.env (untracked) and adjust. This example contains no secrets; never commit real values.
# Compose reads this file for the published port and passes every variable into the ArgueBot container.

# Host loopback port for the dashboard and API. The container always listens on 4317.
ARGUEBOT_PORT=4317

# Host names, besides 127.0.0.1 and localhost, that browsers and clients may use, comma-separated.
# Needed when the service is reached through a reverse proxy or LAN name. Serve those names over HTTPS.
# ARGUEBOT_ALLOWED_HOSTS=arguebot.example.com

# Provider settings a harness may inherit. They reach an agent only when its harness lists the name under
# Inherited environment names. Prefer importing secrets on the Participants > Secrets tab; if you set an API key
# here instead, put the real value only in your untracked docker/.env.
# GEMINI_API_KEY=
# OPENAI_BASE_URL=
